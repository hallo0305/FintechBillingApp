<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- KARTU INFORMASI INVOICE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#F3E8F7">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvInvoiceNo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="INV-2026-FT9012"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#111111" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PAID_SETTLED"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#15803D"
                    android:background="#DCFCE7"
                    android:padding="6dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvMerchantName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Mega Elektrindo Ritel"
                android:textSize="11sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tvCustomerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Penerima: Ahmad Fauzi (081298765432)"
                android:textSize="10sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/tvTransactionDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="23 September 2026, 10:15"
                android:textSize="10sp"
                android:textColor="#666666" />

        </LinearLayout>


        <!-- RINCIAN PRODUK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:background="#F3E8F7">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rincian Produk Belanja"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvInvoiceItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>


        <!-- RINCIAN PEMBAYARAN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:background="#F3E8F7">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rincian Pembayaran"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:layout_marginBottom="8dp" />

            <!-- Subtotal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Subtotal Produk"
                    android:textSize="11sp"
                    android:textColor="#64748B" />

                <TextView
                    android:id="@+id/tvSubtotalAmt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp600.000,00"
                    android:textSize="11sp"
                    android:textColor="#333333" />

            </LinearLayout>

            <!-- Diskon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Diskon Promosi"
                    android:textSize="11sp"
                    android:textColor="#22A06B" />

                <TextView
                    android:id="@+id/tvDiscountAmt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-Rp50.000,00"
                    android:textSize="11sp"
                    android:textColor="#22A06B" />

            </LinearLayout>

            <!-- PPN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PPN 11%"
                    android:textSize="11sp"
                    android:textColor="#64748B" />

                <TextView
                    android:id="@+id/tvTaxAmt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp60.500,00"
                    android:textSize="11sp"
                    android:textColor="#333333" />

            </LinearLayout>

            <!-- Biaya Layanan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Biaya Layanan"
                    android:textSize="11sp"
                    android:textColor="#64748B" />

                <TextView
                    android:id="@+id/tvFeeAmt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp2.500,00"
                    android:textSize="11sp"
                    android:textColor="#333333" />

            </LinearLayout>

            <!-- Total -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="#D8C6DE" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total Bayar"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#111111" />

                <TextView
                    android:id="@+id/tvTotalPaid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp613.000,00"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#2864E8" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>